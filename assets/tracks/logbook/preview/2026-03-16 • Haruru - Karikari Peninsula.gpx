    <wpt lat="-34.8296439" lon="173.4077096">
        <time>2026-03-15T08:08:56Z</time>
        <name>Maitai Bay Campsite</name>
        <extensions>
            <osmand:color>#237BFF</osmand:color>
            <osmand:icon>tourism_camp_site</osmand:icon>
            <osmand:background>square</osmand:background>
            <osmand:address>Matai Bay Headland Track, Kait&#257;ia</osmand:address>
            <osmand:amenity_name>Maitai Bay Campsite</osmand:amenity_name>
            <osmand:osm_tag_shower_cold>cold</osmand:osm_tag_shower_cold>
            <osmand:osm_tag_note>Directions: 25 km southeast of Kaitaia on SH10, turn onto Inland Rd at Karikari Peninsula and follow, then onto Matai Bay Rd. Access: 2 km of gravel.</osmand:osm_tag_note>
            <osmand:osm_tag_sanitary_dump_station_no>no</osmand:osm_tag_sanitary_dump_station_no>
            <osmand:amenity_subtype>camp_site</osmand:amenity_subtype>
            <osmand:osm_tag_capacity_caravans>0</osmand:osm_tag_capacity_caravans>
            <osmand:collapsable_tents>yes</osmand:collapsable_tents>
            <osmand:collapsable_toilets>yes</osmand:collapsable_toilets>
            <osmand:osm_tag_power_supply_no>no</osmand:osm_tag_power_supply_no>
            <osmand:osm_tag_note_tag>yes</osmand:osm_tag_note_tag>
            <osmand:osm_tag_operator>Department of Conservation</osmand:osm_tag_operator>
            <osmand:collapsable_dog>no</osmand:collapsable_dog>
            <osmand:collapsable_reservation>no</osmand:collapsable_reservation>
            <osmand:collapsable_caravans>yes</osmand:collapsable_caravans>
            <osmand:osm_tag_toilets_disposal_flush>flush</osmand:osm_tag_toilets_disposal_flush>
            <osmand:amenity_type>tourism</osmand:amenity_type>
            <osmand:osm_tag_website>https://doc.govt.nz/link/f2b36c981bed49769187977b5db6e330</osmand:osm_tag_website>
            <osmand:osm_tag_description>This is a scenic campsite in the Kaitaia area, popular with families and boaties. Camp in a sheltered bay with campsites nestled amongst beautiful pohutukawa trees.</osmand:osm_tag_description>
            <osmand:osm_tag_capacity_tents>100</osmand:osm_tag_capacity_tents>
            <osmand:collapsable_wheelchair_accessibility>limited</osmand:collapsable_wheelchair_accessibility>
            <osmand:amenity_origin>Amenity:Maitai Bay Campsite: tourism:camp_site</osmand:amenity_origin>
        </extensions>
    </wpt>
