            <osmand:osm_tag_description>This is a scenic campsite in the Whang&#257;rei area. Camp behind the sand dunes of Uretiti Beach, a sandy surf beach.</osmand:osm_tag_description>
            <osmand:osm_tag_capacity_tents>300</osmand:osm_tag_capacity_tents>
            <osmand:collapsable_wheelchair_accessibility>yes</osmand:collapsable_wheelchair_accessibility>
            <osmand:amenity_origin>Amenity:Uretiti Beach Campsite: tourism:camp_site</osmand:amenity_origin>
        </extensions>
    </wpt>
