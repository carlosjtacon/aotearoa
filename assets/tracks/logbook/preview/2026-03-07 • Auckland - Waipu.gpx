        <time>2026-03-15T07:57:15Z</time>
        <name>Uretiti Beach Campsite</name>
        <extensions>
            <osmand:color>#237BFF</osmand:color>
            <osmand:icon>tourism_camp_site</osmand:icon>
            <osmand:background>square</osmand:background>
            <osmand:address>Whangarei Heads Road, Taurikura</osmand:address>
            <osmand:amenity_name>Uretiti Beach Campsite</osmand:amenity_name>
            <osmand:collapsable_shelter_filter>yes</osmand:collapsable_shelter_filter>
            <osmand:amenity_subtype>camp_site</osmand:amenity_subtype>
            <osmand:osm_tag_capacity_caravans>0</osmand:osm_tag_capacity_caravans>
            <osmand:collapsable_tents>yes</osmand:collapsable_tents>
            <osmand:collapsable_fee>yes</osmand:collapsable_fee>
            <osmand:collapsable_toilets>yes</osmand:collapsable_toilets>
            <osmand:collapsable_drinking_water>yes</osmand:collapsable_drinking_water>
            <osmand:osm_tag_toilets_disposal_pitlatrine>pitlatrine</osmand:osm_tag_toilets_disposal_pitlatrine>
            <osmand:osm_tag_operator>Department of Conservation</osmand:osm_tag_operator>
            <osmand:osm_tag_shower_hot>hot</osmand:osm_tag_shower_hot>
            <osmand:osm_tag_charge>$15/person/night;$7.50/child/night;$0/child &lt; 5 years</osmand:osm_tag_charge>
            <osmand:collapsable_dog>no</osmand:collapsable_dog>
            <osmand:collapsable_reservation>required</osmand:collapsable_reservation>
            <osmand:collapsable_caravans>yes</osmand:collapsable_caravans>
            <osmand:osm_tag_capacity>300</osmand:osm_tag_capacity>
