            <osmand:osm_tag_description>The Broken Hills Campsite is located beside the Tairua River among native bush. This is a scenic campsite in the Coromandel region.</osmand:osm_tag_description>
            <osmand:osm_tag_capacity_tents>45</osmand:osm_tag_capacity_tents>
            <osmand:collapsable_wheelchair_accessibility>yes</osmand:collapsable_wheelchair_accessibility>
