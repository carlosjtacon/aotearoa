        <name>Uretiti Beach Campsite</name>
        <extensions>
            <osmand:color>#237BFF</osmand:color>
            <osmand:icon>tourism_camp_site</osmand:icon>
            <osmand:background>square</osmand:background>
            <osmand:address>Whangarei Heads Road, Taurikura</osmand:address>
            <osmand:amenity_name>Uretiti Beach Campsite</osmand:amenity_name>
            <osmand:collapsable_shelter_filter>yes</osmand:collapsable_shelter_filter>
            <osmand:amenity_subtype>camp_site</osmand:amenity_subtype>
            <osmand:osm_tag_capacity_caravans>0</osmand:osm_tag_capacity_caravans>
