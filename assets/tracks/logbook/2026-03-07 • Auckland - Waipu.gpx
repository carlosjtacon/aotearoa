            <osmand:osm_tag_description>This is a scenic campsite in the Whangārei area. Camp behind the sand dunes of Uretiti Beach, a sandy surf beach.</osmand:osm_tag_description>
            <osmand:osm_tag_capacity_tents>300</osmand:osm_tag_capacity_tents>
            <osmand:collapsable_wheelchair_accessibility>yes</osmand:collapsable_wheelchair_accessibility>
